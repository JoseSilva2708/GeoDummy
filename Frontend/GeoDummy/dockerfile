# ---------------------------
# Etapa 1: Build (Node.js)
# ---------------------------
FROM node:20 AS build

# Definir diretório de trabalho
WORKDIR /app

# Copiar ficheiros de configuração
COPY package.json package-lock.json ./

# Instalar dependências
RUN npm ci

# Copiar todo o resto do projeto
COPY . .

# Build do frontend com Vite
# Esta linha vai gerar a pasta /app/build
RUN npm run build

# ---------------------------
# Etapa 2: Servir com Nginx
# ---------------------------
FROM nginx:stable-alpine

# Copiar build do Node.js para o Nginx
COPY --from=build /app/build /usr/share/nginx/html

# Expor porta HTTP
EXPOSE 80

# Comando para arrancar o Nginx em foreground
CMD ["nginx", "-g", "daemon off;"]
